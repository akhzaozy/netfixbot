# ============================================================
# Netflix Email Watcher - WhatsApp Bot Configuration
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke repository!
# ============================================================

# ---- Gmail IMAP Settings ----
# Host IMAP Gmail (jangan diubah)
EMAIL_HOST=imap.gmail.com

# Port IMAP Gmail dengan SSL (jangan diubah)
EMAIL_PORT=993

# Alamat email Gmail Anda
EMAIL_USER=akhza.04@gmail.com

# App Password Gmail (BUKAN password akun biasa)
# Cara mendapatkan: https://myaccount.google.com/apppasswords
# (Aktifkan 2FA terlebih dahulu, lalu buat App Password baru)
EMAIL_PASS=wrwk dliq cmxc nobe

# ---- WhatsApp Bot Settings ----
# Nomor HP Owner dengan kode negara, tanpa +
# Contoh: 628123456789 (untuk +62 812 3456 789)
OWNER_NUMBER=6285161965431
# Berapa menit pengguna yang melakukan .netflix req
# akan berada dalam daftar tunggu sebelum expire (default: 5)
WAITING_ROOM_TTL_MINUTES=5
