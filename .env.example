# ============================================================
# AutoNetflix — Email Auto-Confirm Bot
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke repository!
# ============================================================

# ---- Gmail IMAP Settings ----
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=youremail@gmail.com

# App Password Gmail (BUKAN password akun biasa)
# Cara: myaccount.google.com/apppasswords
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ---- Bot Settings ----
# Set ke true agar bot otomatis konfirmasi saat email masuk
AUTO_CONFIRM=true

# ---- Akun Netflix ----
# Email dan password Netflix yang digunakan untuk login otomatis
# Bot hanya login saat ada email konfirmasi masuk
NETFLIX_EMAIL=emailnetflix@gmail.com
NETFLIX_PASSWORD=passwordnetflixanda
