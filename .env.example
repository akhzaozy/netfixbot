# ============================================================
# AutoNetflix — Email Auto-Confirm Bot
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke repository!
# ============================================================

# ---- Gmail IMAP (untuk baca email Netflix) ----
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ---- Bot Settings ----
AUTO_CONFIRM=true

# ---- Akun Netflix ----
# Email akun Netflix (TIDAK perlu password!)
# Bot akan minta Netflix kirim magic link ke email ini saat perlu login
NETFLIX_EMAIL=youremail@gmail.com
